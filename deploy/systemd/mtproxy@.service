[Unit]
Description=MTPanel MTProto proxy worker %i
After=network-online.target mtpanel-netrules.service
Wants=network-online.target
# bounded automatic restarts: at most 5 starts per 5 minutes, then the unit stays failed
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=mtproxy
Group=mtproxy
EnvironmentFile=/etc/mtpanel/workers/%i.env
ExecStart=/usr/local/lib/mtpanel/run-worker.sh
Restart=on-failure
RestartSec=3
Slice=system-mtproxy.slice
CPUAccounting=yes
MemoryAccounting=yes
TasksMax=4096
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
