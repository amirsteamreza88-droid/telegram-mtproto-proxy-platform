# Local development. In production install.sh writes /etc/mtpanel/panel.env.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# 64 hex chars (openssl rand -hex 32). Encrypts proxy secrets, sponsor tags and backups.
# If unset in development a key is generated in .data/secret.key
APP_SECRET_KEY=
PORT=3000
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
DATA_DIR=./.data
BACKUP_DIR=./.data/backups
HOST_HELPER=/usr/local/sbin/mtpanel-helper
PANEL_PUBLIC_PORT=8443
# Optional: require this token on the first-run /setup page
SETUP_TOKEN=
# Set to 1 to disable background services (monitor/protection/jobs) in this process
MTP_DISABLE_RUNTIME=0
